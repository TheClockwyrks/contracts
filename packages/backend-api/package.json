{
  "name": "@clockwyrks/backend-api",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheClockwyrks/contracts.git",
    "directory": "packages/backend-api"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./comparison": {
      "types": "./dist/comparison.d.ts",
      "default": "./dist/comparison.js"
    },
    "./coverage": {
      "types": "./dist/coverage.d.ts",
      "default": "./dist/coverage.js"
    },
    "./gg": {
      "types": "./dist/gg.d.ts",
      "default": "./dist/gg.js"
    },
    "./gg-system-prompt": {
      "types": "./dist/gg-system-prompt.d.ts",
      "default": "./dist/gg-system-prompt.js"
    },
    "./gg-query": {
      "types": "./dist/gg-query.d.ts",
      "default": "./dist/gg-query.js"
    },
    "./jobs-api": {
      "types": "./dist/jobs-api.d.ts",
      "default": "./dist/jobs-api.js"
    },
    "./ladders": {
      "types": "./dist/ladders.d.ts",
      "default": "./dist/ladders.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "default": "./dist/review.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "default": "./dist/snapshot.js"
    },
    "./tournament": {
      "types": "./dist/tournament.d.ts",
      "default": "./dist/tournament.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "@clockwyrks/run-record": "^0.2.1"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/genyume/the-test-cabinet/_packaging/the-test-cabinet/npm/registry/"
  }
}
